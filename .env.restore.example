# ============================================================
# Album Mundial 2026 — Restore target credentials template
#
# INSTRUCCIONES:
# 1. Copiar: cp .env.restore.example .env.restore
# 2. Llenar con las credenciales del proyecto DESTINO
# 3. NUNCA commitear .env.restore (está en .gitignore)
#
# ESCENARIOS:
#   - Restaurar a nuevo proyecto: poner URL del nuevo proyecto
#   - Restaurar al mismo proyecto: copiar valores de .env.backup
# ============================================================

# URL del proyecto Supabase DESTINO (puede ser el mismo u otro)
SUPABASE_URL=https://nuevo-proyecto.supabase.co

# Service role key del proyecto DESTINO
# Supabase Dashboard → Settings → API → service_role (secret key)
SUPABASE_SERVICE_ROLE_KEY=your-target-service-role-key-here
