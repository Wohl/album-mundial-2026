# ============================================================
# Album Mundial 2026 — Backup credentials template
#
# INSTRUCCIONES:
# 1. Copiar este archivo: cp .env.backup.example .env.backup
# 2. Pegar los valores desde Supabase Dashboard → Settings → API
# 3. NUNCA commitear .env.backup (ya está en .gitignore)
# ============================================================

# URL del proyecto Supabase (igual a NEXT_PUBLIC_SUPABASE_URL)
SUPABASE_URL=https://hngymqusifirjurlyacv.supabase.co

# Service role key — SECRETO, solo para scripts locales.
# Supabase Dashboard → Settings → API → service_role (secret key)
# Esta clave bypasea RLS y puede leer/escribir cualquier dato.
# NUNCA usar en código de frontend ni en Vercel.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
